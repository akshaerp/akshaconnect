NODE_ENV=development
PORT=4100
AKSHACONNECT_SERVICE_NAME=akshaconnect-api

# P0-V5 provider architecture. Pure standalone mode is the intended default.
AKSHACONNECT_IDENTITY_PROVIDER=LOCAL
AKSHACONNECT_BUSINESS_PROVIDER=NONE

# AkshaERP native connector configuration. Required only when either provider
# above is AKSHAERP. Keep the legacy flag N during migration from P0-V4.
AKSHACONNECT_ERP_INTEGRATION_ENABLED=N
AKSHACONNECT_ERP_BASE_URL=https://erp.example.invalid
AKSHACONNECT_SERVICE_ID=akshaconnect
AKSHACONNECT_ERP_CONTRACT_VERSION=1.0
AKSHACONNECT_ERP_TIMEOUT_MS=5000
# Supply through the deployment secret store; never commit a real secret.
AKSHACONNECT_ERP_SHARED_SECRET=
