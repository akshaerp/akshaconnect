NODE_ENV=development
PORT=4100
AKSHACONNECT_SERVICE_NAME=akshaconnect-api

# P0-V6B provider architecture. Pure standalone mode remains the intended default.
AKSHACONNECT_IDENTITY_PROVIDER=LOCAL
AKSHACONNECT_BUSINESS_PROVIDER=NONE

# Legacy activation flag retained during Phase 0 migration. New deployments should
# use the explicit provider variables above.
AKSHACONNECT_ERP_INTEGRATION_ENABLED=N

# AkshaERP native connector configuration. Required only when either provider
# above is AKSHAERP. Credentials are created/configured in AkshaERP Integration Gateway.
AKSHACONNECT_ERP_BASE_URL=https://erp.example.invalid
AKSHACONNECT_ERP_API_CLIENT_ID=
# Supply through the deployment secret store; never commit a real API key.
AKSHACONNECT_ERP_API_KEY=
AKSHACONNECT_ERP_TIMEOUT_MS=5000
