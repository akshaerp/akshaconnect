{
  "name": "@akshaerp/akshaconnect",
  "version": "0.10.0-phase1",
  "private": true,
  "description": "AkshaConnect standalone product monorepo",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start:api": "node services/api/src/server.js",
    "start:web": "npm --workspace @akshaerp/akshaconnect-web run dev",
    "build:web": "npm --workspace @akshaerp/akshaconnect-web run build",
    "lint": "node scripts/check-js.js",
    "test": "node --test",
    "verify": "npm run lint && npm test && npm run build:web"
  }
}
